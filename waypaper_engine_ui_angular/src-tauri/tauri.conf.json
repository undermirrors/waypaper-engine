{
  "productName": "waypaper-engine-ui",
  "version": "0.0.0",
  "identifier": "fr.flashonfire.waypaperengine",
  "build": {
    "frontendDist": "../dist/waypaper_engine_ui_angular/browser",
    "devUrl": "http://localhost:4200",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Waypaper Engine",
        "width": 1700,
        "height": 800,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
    ]
  }
}
